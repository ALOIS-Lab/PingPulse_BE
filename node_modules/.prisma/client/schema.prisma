generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Website {
  id                   String            @id @default(uuid())
  website_name         String
  website_url          String
  expected_status_code Int               @default(200)
  expected_keyword     String?
  monitoring_enabled   Boolean           @default(true)
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  logs                 AvailabilityLog[]
  alerts               Alert[]

  @@map("websites")
}

model AvailabilityLog {
  id               String   @id @default(uuid())
  website_id       String
  website          Website  @relation(fields: [website_id], references: [id], onDelete: Cascade)
  status           String // e.g., 'UP', 'DOWN', 'ERROR'
  http_status      Int?
  response_time_ms Int?
  checked_at       DateTime @default(now())
  error_message    String?
  screenshot_path  String?

  @@map("availability_logs")
}

model Alert {
  id             String    @id @default(uuid())
  website_id     String
  website        Website   @relation(fields: [website_id], references: [id], onDelete: Cascade)
  failure_reason String?
  severity       String    @default("HIGH")
  resolved       Boolean   @default(false)
  created_at     DateTime  @default(now())
  resolved_at    DateTime?
  email_sent     Boolean   @default(false)

  @@map("alerts")
}

model GlobalSetting {
  id                      String  @id @default("default")
  monitoring_interval     Int     @default(60) // in seconds
  http_timeout_ms         Int     @default(10000)
  max_response_time_ms    Int     @default(5000)
  retry_attempts          Int     @default(1)
  default_expected_status Int     @default(200)
  monitoring_enabled      Boolean @default(true)

  @@map("global_settings")
}

model NotificationSettings {
  id                         String   @id @default("default")
  enable_email_notifications Boolean  @default(false)
  sender_email               String?
  sender_app_password        String?
  recipient_email            String?
  alert_delay_minutes        Int      @default(0)
  smtp_host                  String?
  smtp_port                  Int?
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  @@map("notification_settings")
}
